---
source: crates/sparewall-render/tests/render.rs
expression: r.meta
---
preserved_sets: []
set_links: {}
required_links:
  - mgmt0
vip_links: []
services:
  ntp:
    provider: chrony
    unit: chronyd.service
    subsystem: ntp
    reload: false
    check:
      container: ~
      mount: /run/chrony
      command:
        - chronyd
        - "-p"
        - "-f"
        - /run/chrony/sparewall.conf
  ssh:
    provider: openssh
    unit: sshd.service
    subsystem: ssh
    reload: true
    check: ~
bootstrap: true
