expression: lan
---
# Generated by sparewalld. Do not edit: change the configuration document instead.

[Match]
Name=lan0

[Network]
LLDP=yes
EmitLLDP=nearest-bridge
Address=192.168.1.1/24
DHCPPrefixDelegation=yes
IPv6SendRA=yes
LinkLocalAddressing=ipv6
