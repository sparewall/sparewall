---
source: crates/sparewall-render/tests/render.rs
expression: nft
---
# Generated by sparewalld. Do not edit: change the configuration document instead.
table inet sparewall {
	set lab6 {
		type ipv6_addr
		flags interval
		auto-merge
		elements = { 2001:db8:0:2::/64 }
	}
	set nas {
		type ipv6_addr
		flags interval
		auto-merge
		elements = { 2001:db8:ffff::5, 2001:db8:0:2::20 }
	}
	set nas4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 192.168.2.20 }
	}
	set wan6 {
		type ipv6_addr
		flags interval
		auto-merge
	}
	chain prerouting_raw {
		type filter hook prerouting priority raw; policy accept;
	}
	chain prerouting_nat {
		type nat hook prerouting priority dstnat; policy accept;
	}
	chain input {
		type filter hook input priority filter; policy drop;
		icmpv6 type nd-neighbor-solicit icmpv6 code 0 ip6 hoplimit 255 ip6 saddr != ff00::/8 accept comment "ipv6-nd"
		icmpv6 type nd-neighbor-advert icmpv6 code 0 ip6 hoplimit 255 ip6 saddr != { ::, ff00::/8 } accept comment "ipv6-nd"
		icmpv6 type { mld-listener-query, mld2-listener-report } ip6 saddr fe80::/10 accept comment "ipv6-mld"
		meta nfproto ipv6 iifname != { "lo", "lab0", "lan0", "wan0" } drop comment "ipv6-off"
		ct state vmap { established : accept, related : accept, invalid : drop }
		iifname "lo" accept
		iifname "lan0" meta nfproto ipv4 ip saddr 192.168.1.10 tcp dport { 22, 443 } accept comment "anti-lockout"
		iifname { "lab0", "lan0" } icmpv6 type nd-router-solicit icmpv6 code 0 ip6 hoplimit 255 accept comment "ipv6-router-solicit"
		iifname "wan0" icmpv6 type nd-router-advert icmpv6 code 0 ip6 saddr fe80::/10 ip6 hoplimit 255 accept comment "ipv6-router-advert"
		icmp type echo-request limit rate over 50/second burst 100 packets drop comment "icmp-flood"
		icmpv6 type echo-request limit rate over 50/second burst 100 packets drop comment "icmpv6-flood"
		iifname "wan0" udp sport 67 udp dport 68 accept comment "infra:dhcp-client"
		iifname "wan0" udp sport 547 udp dport 546 accept comment "infra:dhcpv6-client"
		iifname "lan0" udp dport 67 accept comment "service:dhcp"
		iifname "lan0" meta l4proto { tcp, udp } th dport 53 accept comment "service:dns"
		iifname vmap { "lan0" : jump in_lan, "wan0" : jump in_wan }
		counter comment "default:input"
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		meta nfproto ipv6 iifname != { "lab0", "lan0", "wan0" } drop comment "ipv6-off"
		meta nfproto ipv6 oifname != { "lab0", "lan0", "wan0" } drop comment "ipv6-off"
		ct state vmap { established : accept, related : accept, invalid : drop }
		iifname . oifname vmap { "lab0" . "wan0" : jump fwd_lab_wan, "lan0" . "wan0" : jump fwd_lan_wan, "wan0" . "lab0" : jump fwd_wan_lab }
		counter comment "default:forward"
	}
	chain output {
		type filter hook output priority filter; policy accept;
	}
	chain postrouting_nat {
		type nat hook postrouting priority srcnat; policy accept;
		iifname "lab0" oifname "wan0" meta nfproto ipv4 counter masquerade comment "nat:lab->wan"
		iifname "lan0" oifname "wan0" meta nfproto ipv4 counter masquerade comment "nat:lan->wan"
	}
	chain fwd_lab_wan {
		counter accept comment "default:lab->wan"
	}
	chain in_lan {
		icmp type echo-request counter accept comment "rule:lan->self:ping"
		udp dport 53 counter accept comment "rule:lan->self:dns"
		counter drop comment "default:lan->self"
	}
	chain fwd_lan_wan {
		counter accept comment "default:lan->wan"
	}
	chain fwd_wan_lab {
		ip daddr @nas4 tcp dport 443 counter accept comment "rule:wan->lab:nas-https"
		ip6 daddr @nas tcp dport 443 counter accept comment "rule:wan->lab:nas-https"
		icmpv6 type echo-request counter accept comment "rule:wan->lab:ping6"
		icmp type echo-request counter accept comment "rule:wan->lab:ping4"
		tcp dport 22 counter drop comment "rule:wan->lab:ssh"
		ip6 saddr 2001:db8:beef::/48 ip6 daddr 2001:db8:0:2::/64 counter reject comment "rule:wan->lab:doc6"
		counter drop comment "default:wan->lab"
	}
	chain in_wan {
		counter drop comment "default:wan->self"
	}
}
