---
source: crates/sparewall-render/tests/render.rs
expression: conf(&r).unwrap()
---
# Generated by sparewalld. Do not edit: change the configuration document instead.
global:
  scrape_interval: 15s

# The oldest goes first once either limit is reached.
storage:
  tsdb:
    retention:
      time: 30d
      size: 512MB

scrape_configs:
  # The coordinator's /metrics, with node_exporter's: on loopback it
  # needs no token in this mode. Its certificate is for the
  # management network's names, not loopback's.
  - job_name: sparewall
    scheme: https
    tls_config:
      insecure_skip_verify: true
    static_configs:
      - targets: ["127.0.0.1:443"]
        labels:
          instance: fw2
  # Its own storage: how much history it holds.
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]
        labels:
          instance: fw2
