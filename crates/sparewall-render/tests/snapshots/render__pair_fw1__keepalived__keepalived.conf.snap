---
source: crates/sparewall-render/tests/render.rs
expression: content
---
# Generated by sparewalld. Do not edit: change the configuration document instead.
global_defs {
    router_id fw1
    vrrp_version 3
    enable_script_security
    script_user root
    notify_fifo /run/sparewall/keepalived.fifo
    vrrp_garp_master_refresh 60
}

vrrp_script sparewall_health {
    script "/usr/bin/sparewall health --quiet"
    interval 2
    timeout 5
    fall 3
    rise 2
}

vrrp_sync_group SPAREWALL {
    group {
        VI_users
        VI_wan
    }
}

vrrp_instance VI_users {
    state BACKUP
    nopreempt
    interface users
    virtual_router_id 20
    priority 150
    advert_int 1
    garp_master_delay 1
    track_interface {
        uplink
    }
    track_script {
        sparewall_health
    }
    virtual_ipaddress {
        192.0.2.1/24 dev users
    }
}

vrrp_instance VI_wan {
    state BACKUP
    nopreempt
    interface wan
    virtual_router_id 10
    priority 150
    advert_int 1
    garp_master_delay 1
    track_interface {
        uplink
    }
    track_script {
        sparewall_health
    }
    virtual_ipaddress {
        203.0.113.1/29 dev wan
    }
}
