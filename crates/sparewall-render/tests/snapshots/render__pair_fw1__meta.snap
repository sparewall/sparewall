---
source: crates/sparewall-render/tests/render.rs
expression: r.meta
---
preserved_sets: []
set_links: {}
required_links:
  - mgmt
  - uplink
  - users
  - wan
replication_links:
  - sync
vip_links:
  - users
  - wan
services:
  dhcp:
    provider: kea
    unit: sparewall-kea.service
    subsystem: dhcp
    reload: true
    check:
      container: sparewall-kea
      mount: /etc/kea
      command:
        - kea-dhcp4
        - "-t"
        - /etc/kea/kea-dhcp4.conf
      overrides:
        kea-dhcp4.conf: "{\n  \"Dhcp4\": {\n    \"authoritative\": false,\n    \"control-sockets\": [\n      {\n        \"socket-name\": \"kea4-ctrl-socket\",\n        \"socket-type\": \"unix\"\n      }\n    ],\n    \"hooks-libraries\": [\n      {\n        \"library\": \"/usr/lib64/kea/hooks/libdhcp_lease_cmds.so\"\n      },\n      {\n        \"library\": \"/usr/lib64/kea/hooks/libdhcp_ping_check.so\",\n        \"parameters\": {\n          \"enable-ping-check\": true,\n          \"min-ping-requests\": 1,\n          \"ping-cltt-secs\": 60,\n          \"reply-timeout\": 200\n        }\n      }\n    ],\n    \"interfaces-config\": {\n      \"dhcp-socket-type\": \"raw\",\n      \"interfaces\": [\n        \"*\"\n      ],\n      \"service-sockets-max-retries\": 60,\n      \"service-sockets-require-all\": false,\n      \"service-sockets-retry-wait-time\": 5000\n    },\n    \"lease-database\": {\n      \"lfc-interval\": 3600,\n      \"name\": \"/var/lib/kea/kea-leases4.csv\",\n      \"persist\": true,\n      \"type\": \"memfile\"\n    },\n    \"loggers\": [\n      {\n        \"name\": \"kea-dhcp4\",\n        \"output-options\": [\n          {\n            \"output\": \"stdout\",\n            \"pattern\": \"%-5p %m\\n\"\n          }\n        ],\n        \"severity\": \"INFO\"\n      }\n    ],\n    \"subnet4\": [\n      {\n        \"id\": 20,\n        \"option-data\": [\n          {\n            \"data\": \"192.0.2.1\",\n            \"name\": \"routers\"\n          },\n          {\n            \"data\": \"192.0.2.1\",\n            \"name\": \"domain-name-servers\"\n          }\n        ],\n        \"pools\": [],\n        \"reservations\": [],\n        \"subnet\": \"192.0.2.0/24\"\n      }\n    ],\n    \"valid-lifetime\": 86400\n  }\n}\n"
  dns:
    provider: unbound
    unit: sparewall-unbound.service
    subsystem: dns
    reload: true
    check:
      container: sparewall-unbound
      mount: /etc/unbound
      command:
        - unbound-checkconf
        - /etc/unbound/unbound.conf
  ntp:
    provider: chrony
    unit: chronyd.service
    subsystem: ntp
    reload: false
    check:
      container: ~
      mount: /run/chrony
      command:
        - chronyd
        - "-p"
        - "-f"
        - /run/chrony/sparewall.conf
  vrrp:
    provider: keepalived
    unit: keepalived.service
    subsystem: keepalived
    reload: true
    check:
      container: ~
      mount: /run/keepalived
      command:
        - unshare
        - "--net"
        - sh
        - "-ec"
        - "for i in uplink users wan; do ip link add \"$i\" type dummy; ip link set \"$i\" multicast on up; done; exec keepalived --config-test --use-file /run/keepalived/keepalived.conf"
bootstrap: false
