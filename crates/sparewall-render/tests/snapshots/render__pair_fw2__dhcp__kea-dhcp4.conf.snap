---
source: crates/sparewall-render/tests/render.rs
expression: content
---
{
  "Dhcp4": {
    "authoritative": true,
    "control-sockets": [
      {
        "socket-name": "kea4-ctrl-socket",
        "socket-type": "unix"
      }
    ],
    "hooks-libraries": [
      {
        "library": "/usr/lib64/kea/hooks/libdhcp_lease_cmds.so"
      },
      {
        "library": "/usr/lib64/kea/hooks/libdhcp_ping_check.so",
        "parameters": {
          "enable-ping-check": true,
          "min-ping-requests": 1,
          "ping-cltt-secs": 60,
          "reply-timeout": 200
        }
      },
      {
        "library": "/usr/lib64/kea/hooks/libdhcp_ha.so",
        "parameters": {
          "high-availability": [
            {
              "heartbeat-delay": 10000,
              "max-ack-delay": 5000,
              "max-response-delay": 60000,
              "max-unacked-clients": 5,
              "mode": "hot-standby",
              "peers": [
                {
                  "auto-failover": true,
                  "name": "fw1",
                  "role": "primary",
                  "url": "http://169.254.77.1:8647/"
                },
                {
                  "auto-failover": true,
                  "name": "fw2",
                  "role": "standby",
                  "url": "http://169.254.77.2:8647/"
                }
              ],
              "this-server-name": "fw2"
            }
          ]
        }
      }
    ],
    "interfaces-config": {
      "dhcp-socket-type": "raw",
      "interfaces": [
        "users/192.0.2.3"
      ],
      "service-sockets-max-retries": 60,
      "service-sockets-require-all": false,
      "service-sockets-retry-wait-time": 5000
    },
    "lease-database": {
      "lfc-interval": 3600,
      "name": "/var/lib/kea/kea-leases4.csv",
      "persist": true,
      "type": "memfile"
    },
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output-options": [
          {
            "output": "stdout",
            "pattern": "%-5p %m\n"
          }
        ],
        "severity": "INFO"
      }
    ],
    "subnet4": [
      {
        "id": 20,
        "option-data": [
          {
            "data": "192.0.2.1",
            "name": "routers"
          },
          {
            "data": "192.0.2.1",
            "name": "domain-name-servers"
          }
        ],
        "pools": [
          {
            "pool": "192.0.2.100 - 192.0.2.199"
          }
        ],
        "reservations": [],
        "subnet": "192.0.2.0/24"
      }
    ],
    "valid-lifetime": 86400
  }
}
