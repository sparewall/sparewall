---
source: crates/sparewall-render/tests/render.rs
expression: content
---
{
  "Dhcp4": {
    "authoritative": false,
    "control-sockets": [
      {
        "socket-name": "kea4-ctrl-socket",
        "socket-type": "unix"
      }
    ],
    "hooks-libraries": [
      {
        "library": "/usr/lib64/kea/hooks/libdhcp_lease_cmds.so"
      },
      {
        "library": "/usr/lib64/kea/hooks/libdhcp_ping_check.so",
        "parameters": {
          "enable-ping-check": true,
          "min-ping-requests": 1,
          "ping-cltt-secs": 60,
          "reply-timeout": 200
        }
      }
    ],
    "interfaces-config": {
      "dhcp-socket-type": "raw",
      "interfaces": [
        "users/192.0.2.3"
      ],
      "service-sockets-max-retries": 60,
      "service-sockets-require-all": false,
      "service-sockets-retry-wait-time": 5000
    },
    "lease-database": {
      "lfc-interval": 3600,
      "name": "/var/lib/kea/kea-leases4.csv",
      "persist": true,
      "type": "memfile"
    },
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output-options": [
          {
            "output": "stdout",
            "pattern": "%-5p %m\n"
          }
        ],
        "severity": "INFO"
      }
    ],
    "subnet4": [
      {
        "id": 20,
        "option-data": [
          {
            "data": "192.0.2.1",
            "name": "routers"
          },
          {
            "data": "192.0.2.1",
            "name": "domain-name-servers"
          }
        ],
        "pools": [],
        "reservations": [],
        "subnet": "192.0.2.0/24"
      }
    ],
    "valid-lifetime": 86400
  }
}
