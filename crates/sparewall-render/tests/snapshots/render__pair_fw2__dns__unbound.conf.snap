# Generated by sparewalld. Do not edit: change the configuration document instead.
server:
    interface: 10.99.0.1
    interface: 127.0.0.1
    interface: 192.0.2.1
    ip-freebind: yes
    do-ip6: no
    port: 53
    access-control: 0.0.0.0/0 refuse
    access-control: 127.0.0.0/8 allow
    access-control: 10.99.0.0/24 allow
    access-control: 192.0.2.0/24 allow
    username: "unbound"
    directory: "/etc/unbound"
    chroot: ""
    pidfile: ""
    use-syslog: no
    logfile: ""
    log-time-ascii: yes
    verbosity: 1
    hide-identity: yes
    hide-version: yes
    qname-minimisation: yes
    harden-glue: yes
    harden-dnssec-stripped: yes
    use-caps-for-id: no
    prefetch: yes
    so-reuseport: yes
    auto-trust-anchor-file: "/var/lib/unbound/root.key"

remote-control:
    control-enable: yes
    control-interface: /run/unbound/control.sock
