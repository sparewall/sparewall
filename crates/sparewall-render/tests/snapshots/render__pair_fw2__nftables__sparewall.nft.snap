---
source: crates/sparewall-render/tests/render.rs
expression: content
---
# Generated by sparewalld. Do not edit: change the configuration document instead.
table inet sparewall {
	set admin_nets {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 10.0.99.0/24 }
	}
	chain prerouting_raw {
		type filter hook prerouting priority raw; policy accept;
		ip protocol vrrp notrack comment "raw:notrack-vrrp"
	}
	chain prerouting_nat {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "wan" ip daddr 203.0.113.1 udp dport { 53, 443 } counter dnat ip to 203.0.113.1:51820 comment "vpn-roadwarrior:extra-ports"
	}
	chain input {
		type filter hook input priority filter; policy drop;
		iifname != { "lo", "swsync" } ip daddr 169.254.77.0/30 drop comment "infra:sync-isolation"
		ct state vmap { established : accept, related : accept, invalid : drop }
		iifname "lo" accept
		iifname "mgmt" tcp dport { 22, 443 } accept comment "anti-lockout"
		meta l4proto ipv6-icmp icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, mld-listener-query, mld2-listener-report } ip6 saddr fe80::/10 accept comment "ipv6-link-local"
		meta nfproto ipv6 drop
		icmp type echo-request limit rate over 50/second burst 100 packets drop comment "icmp-flood"
		iifname { "users", "wan" } ip protocol vrrp accept comment "infra:vrrp"
		iifname "sync" ip saddr 10.255.0.1 udp dport 51871 accept comment "infra:sync-tunnel"
		iifname "swsync" accept comment "infra:sync-peer"
		iifname "sync" drop comment "infra:sync-isolation"
		iifname "users" udp dport 67 accept comment "service:dhcp"
		iifname { "users", "roadwarrior" } meta l4proto { tcp, udp } th dport 53 accept comment "service:dns"
		iifname "wan" udp dport 51820 accept comment "service:vpn-roadwarrior"
		iifname vmap { "wan" : jump in_wan }
		counter comment "default:input"
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		iifname "swsync" drop comment "infra:sync-isolation"
		oifname "swsync" drop comment "infra:sync-isolation"
		oifname "roadwarrior" tcp flags syn tcp option maxseg size set rt mtu comment "vpn-mss"
		ct state vmap { established : accept, related : accept, invalid : drop }
		meta nfproto ipv6 drop
		iifname . oifname vmap { "users" . "wan" : jump fwd_users_wan, "roadwarrior" . "users" : jump fwd_vpn_users, "roadwarrior" . "wan" : jump fwd_vpn_wan }
		counter comment "default:forward"
	}
	chain output {
		type filter hook output priority filter; policy accept;
		oifname "wan" udp sport 51820 ip saddr != 203.0.113.1 drop comment "vpn-roadwarrior:gateway-address-only"
	}
	chain postrouting_nat {
		type nat hook postrouting priority srcnat; policy accept;
		iifname "users" oifname "wan" counter snat ip to 203.0.113.1 comment "nat:users->wan"
		iifname "roadwarrior" oifname "wan" counter snat ip to 203.0.113.1 comment "nat:vpn->wan"
	}
	chain fwd_users_wan {
		counter accept comment "default:users->wan"
	}
	chain fwd_vpn_users {
		counter accept comment "default:vpn->users"
	}
	chain fwd_vpn_wan {
		counter accept comment "default:vpn->wan"
	}
	chain in_wan {
		ip saddr @admin_nets tcp dport 22 counter accept comment "rule:wan->self:ssh-admin"
		counter drop comment "default:wan->self"
	}
}
