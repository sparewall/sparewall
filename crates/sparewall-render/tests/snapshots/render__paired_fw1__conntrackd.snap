---
source: crates/sparewall-render/tests/render.rs
expression: "r.files[\"conntrackd/conntrackd.conf\"]"
---
# Generated by sparewalld. Do not edit: change the configuration document instead.
Sync {
    Mode FTFW {
        DisableExternalCache Off
        CommitTimeout 1800
        PurgeTimeout 5
    }
    UDP {
        IPv4_address 169.254.77.1
        IPv4_Destination_Address 169.254.77.2
        Port 3780
        Interface swsync
        SndSocketBuffer 1249280
        RcvSocketBuffer 1249280
        Checksum on
    }
}

General {
    Systemd on
    HashSize 32768
    HashLimit 524288
    LogFile off
    Syslog on
    LockFile /run/conntrackd.lock
    UNIX {
        Path /run/conntrackd.ctl
    }
    NetlinkBufferSize 2097152
    NetlinkBufferSizeMaxGrowth 8388608
    NetlinkOverrunResync On
    NetlinkEventsReliable On
    Filter From Userspace {
        Protocol Accept {
            TCP
            UDP
            ICMP
        }
        Address Ignore {
            IPv4_address 10.0.99.2
            IPv4_address 10.0.99.3
            IPv4_address 10.255.0.1
            IPv4_address 10.255.0.2
            IPv4_address 127.0.0.1
            IPv4_address 169.254.77.1
            IPv4_address 169.254.77.2
            IPv4_address 192.0.2.2
            IPv4_address 192.0.2.3
            IPv4_address 203.0.113.2
            IPv4_address 203.0.113.3
        }
    }
}
