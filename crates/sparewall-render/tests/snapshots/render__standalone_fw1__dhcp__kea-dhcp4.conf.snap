            "name": "domain-name-servers"
          },
          {
            "data": "192.0.2.1",
            "name": "ntp-servers"
          },
          {
            "data": "home.arpa",
            "name": "domain-name"
          }
        ],
        "pools": [
          {
            "pool": "192.0.2.100 - 192.0.2.199"
          }
        ],
        "reservations": [
          {
            "hostname": "printer",
            "hw-address": "52:54:00:12:34:56",
