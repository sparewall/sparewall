---
source: crates/sparewall-render/tests/render.rs
expression: r.meta
---
preserved_sets:
  - wan_address
set_links:
  wan_address: wan
required_links:
  - guests
  - uplink
  - users
  - wan
vip_links: []
services:
  dhcp:
    provider: kea
    unit: sparewall-kea.service
    subsystem: dhcp
    reload: true
    check:
      container: sparewall-kea
      mount: /etc/kea
      command:
        - kea-dhcp4
        - "-t"
        - /etc/kea/kea-dhcp4.conf
      overrides:
        kea-dhcp4.conf: "{\n  \"Dhcp4\": {\n    \"authoritative\": true,\n    \"control-sockets\": [\n      {\n        \"socket-name\": \"kea4-ctrl-socket\",\n        \"socket-type\": \"unix\"\n      }\n    ],\n    \"hooks-libraries\": [\n      {\n        \"library\": \"/usr/lib64/kea/hooks/libdhcp_lease_cmds.so\"\n      }\n    ],\n    \"interfaces-config\": {\n      \"dhcp-socket-type\": \"raw\",\n      \"interfaces\": [\n        \"*\"\n      ],\n      \"service-sockets-max-retries\": 60,\n      \"service-sockets-require-all\": false,\n      \"service-sockets-retry-wait-time\": 5000\n    },\n    \"lease-database\": {\n      \"lfc-interval\": 3600,\n      \"name\": \"/var/lib/kea/kea-leases4.csv\",\n      \"persist\": true,\n      \"type\": \"memfile\"\n    },\n    \"loggers\": [\n      {\n        \"name\": \"kea-dhcp4\",\n        \"output-options\": [\n          {\n            \"output\": \"stdout\",\n            \"pattern\": \"%-5p %m\\n\"\n          }\n        ],\n        \"severity\": \"INFO\"\n      }\n    ],\n    \"subnet4\": [\n      {\n        \"id\": 20,\n        \"option-data\": [\n          {\n            \"data\": \"192.0.2.1\",\n            \"name\": \"routers\"\n          },\n          {\n            \"data\": \"192.0.2.1\",\n            \"name\": \"domain-name-servers\"\n          },\n          {\n            \"data\": \"192.0.2.1\",\n            \"name\": \"ntp-servers\"\n          },\n          {\n            \"data\": \"home.arpa\",\n            \"name\": \"domain-name\"\n          }\n        ],\n        \"pools\": [\n          {\n            \"pool\": \"192.0.2.100 - 192.0.2.199\"\n          }\n        ],\n        \"reservations\": [\n          {\n            \"hostname\": \"printer\",\n            \"hw-address\": \"52:54:00:12:34:56\",\n            \"ip-address\": \"192.0.2.20\"\n          }\n        ],\n        \"subnet\": \"192.0.2.0/24\"\n      },\n      {\n        \"id\": 30,\n        \"option-data\": [\n          {\n            \"data\": \"198.51.100.1\",\n            \"name\": \"routers\"\n          },\n          {\n            \"data\": \"198.51.100.1\",\n            \"name\": \"domain-name-servers\"\n          },\n          {\n            \"data\": \"198.51.100.1\",\n            \"name\": \"ntp-servers\"\n          },\n          {\n            \"data\": \"home.arpa\",\n            \"name\": \"domain-name\"\n          }\n        ],\n        \"pools\": [\n          {\n            \"pool\": \"198.51.100.100 - 198.51.100.250\"\n          }\n        ],\n        \"reservations\": [],\n        \"subnet\": \"198.51.100.0/24\",\n        \"valid-lifetime\": 3600\n      }\n    ],\n    \"valid-lifetime\": 86400\n  }\n}\n"
  dns:
    provider: unbound
    unit: sparewall-unbound.service
    subsystem: dns
    reload: true
    check:
      container: sparewall-unbound
      mount: /etc/unbound
      command:
        - unbound-checkconf
        - /etc/unbound/unbound.conf
  ntp:
    provider: chrony
    unit: chronyd.service
    subsystem: ntp
    reload: false
    check:
      container: ~
      mount: /run/chrony
      command:
        - chronyd
        - "-p"
        - "-f"
        - /run/chrony/sparewall.conf
  rule-logging:
    provider: ulogd
    unit: sparewall-ulogd.service
    subsystem: logging
    reload: false
    check: ~
bootstrap: false
