---
source: crates/sparewall-render/tests/render.rs
expression: content
---
# Generated by sparewalld. Do not edit: change the configuration document instead.
table inet sparewall {
	set admin_nets {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 10.0.99.0/24, 192.0.2.10 }
	}
	set wan_address {
		type ipv4_addr
		flags interval
		auto-merge
	}
	set web {
		type inet_service
		flags interval
		auto-merge
		elements = { 80, 443 }
	}
	chain prerouting_raw {
		type filter hook prerouting priority raw; policy accept;
	}
	chain prerouting_nat {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "wan" ip daddr @wan_address tcp dport @web counter dnat ip to 192.0.2.80 comment "forward:web-server"
		iifname "users" ip daddr @wan_address tcp dport @web counter dnat ip to 192.0.2.80 comment "forward:web-server:hairpin"
		iifname "guests" ip daddr @wan_address tcp dport @web counter dnat ip to 192.0.2.80 comment "forward:web-server:hairpin"
	}
	chain input {
		type filter hook input priority filter; policy drop;
		ct state vmap { established : accept, related : accept, invalid : drop }
		iifname "lo" accept
		iifname "uplink" tcp dport { 22, 443 } accept comment "anti-lockout"
		meta l4proto ipv6-icmp icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, mld-listener-query, mld2-listener-report } ip6 saddr fe80::/10 accept comment "ipv6-link-local"
		meta nfproto ipv6 drop
		icmp type echo-request limit rate over 50/second burst 100 packets drop comment "icmp-flood"
		iifname "wan" udp sport 67 udp dport 68 accept comment "infra:dhcp-client"
		ip daddr @wan_address tcp dport @web counter reject with tcp reset comment "forward:web-server:not-here"
		iifname { "guests", "users" } udp dport 67 accept comment "service:dhcp"
		iifname { "guests", "users" } meta l4proto { tcp, udp } th dport 53 accept comment "service:dns"
		iifname { "guests", "users" } udp dport 123 accept comment "service:ntp"
		iifname vmap { "guests" : jump in_guests, "users" : jump in_users, "wan" : jump in_wan }
		counter comment "default:input"
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		tcp flags syn tcp option maxseg size set rt mtu comment "raw:mss-clamp"
		ct state vmap { established : accept, related : accept, invalid : drop }
		meta nfproto ipv6 drop
		iifname "users" oifname "users" ip daddr 192.0.2.80 tcp dport @web ct status dnat counter accept comment "forward:web-server:hairpin"
		iifname . oifname vmap { "guests" . "users" : jump fwd_guests_users, "guests" . "wan" : jump fwd_guests_wan, "users" . "guests" : jump fwd_users_guests, "users" . "wan" : jump fwd_users_wan, "wan" . "users" : jump fwd_wan_users }
		counter comment "default:forward"
	}
	chain output {
		type filter hook output priority filter; policy accept;
	}
	chain postrouting_nat {
		type nat hook postrouting priority srcnat; policy accept;
		iifname "users" oifname "users" ip daddr 192.0.2.80 tcp dport @web ct status dnat counter snat ip to 192.0.2.1 comment "forward:web-server:hairpin"
		iifname "guests" oifname "wan" counter masquerade comment "nat:guests->wan"
		iifname "users" oifname "wan" counter masquerade comment "nat:users->wan"
	}
	chain in_guests {
		icmp type echo-request limit rate 5/second counter accept comment "rule:guests->self:ping"
		counter drop comment "default:guests->self"
	}
	chain fwd_guests_users {
		ip daddr 192.0.2.80 tcp dport @web ct status dnat counter accept comment "forward:web-server"
		counter log group 0 prefix "guests->users:default " drop comment "default:guests->users"
	}
	chain fwd_guests_wan {
		counter accept comment "default:guests->wan"
	}
	chain fwd_users_guests {
		counter accept comment "default:users->guests"
	}
	chain in_users {
		icmp type echo-request counter accept comment "rule:users->self:ping"
		ip saddr @admin_nets tcp dport 22 counter accept comment "rule:users->self:ssh"
		counter drop comment "default:users->self"
	}
	chain fwd_users_wan {
		counter accept comment "default:users->wan"
	}
	chain in_wan {
		ip saddr 203.0.113.0/24 counter drop comment "raw:block-scanner"
		icmp type echo-request limit rate 2/second burst 5 packets counter accept comment "rule:wan->self:ping"
		counter drop comment "default:wan->self"
	}
	chain fwd_wan_users {
		ip daddr 192.0.2.80 tcp dport @web ct status dnat counter accept comment "forward:web-server"
		counter drop comment "default:wan->users"
	}
}
