---
source: crates/sparewall-render/tests/render.rs
expression: conf
---
# Generated by sparewalld. Do not edit: change the configuration document instead.
# Only forwarding: nothing is written locally; the journal keeps
# everything.
global(workDirectory="/var/lib/rsyslog")
# From the journal's tail at the first start (not its whole
# history), then from where it left off. No rate limit: rule hits
# can be many, and the queue below bounds what is kept.
module(load="imjournal" StateFile="sparewall-imjournal.state"
       IgnorePreviousMessages="on" Ratelimit.Interval="0")
module(load="omrelp")

template(name="sparewall" type="string"
         string="<%PRI%>1 %TIMESTAMP:::date-rfc3339% %HOSTNAME% %APP-NAME% %PROCID% %MSGID% - %$.msg%\n")

if $!F_RULE != "" then {
    set $.msg = $msg & " rule=" & $!F_RULE & " " & $!F_PACKET;
} else {
    set $.msg = $msg;
}

action(type="omrelp"
       target="logs.example.org"
       port="2514"
       tls="on"
       tls.caCert="/run/sparewall/logging/syslog-ca.pem"
       tls.authMode="name"
       tls.permittedPeer=["logs.example.org"]
       tls.myCert="/run/sparewall/secrets/syslog-client.pem"
       tls.myPrivKey="/run/sparewall/secrets/syslog-client.key"
       template="sparewall"
       queue.type="LinkedList"
       queue.size="100000"
       queue.filename="sparewall-forward"
       queue.maxDiskSpace="256m"
       queue.saveOnShutdown="on"
       action.resumeRetryCount="-1"
       action.resumeInterval="10")
