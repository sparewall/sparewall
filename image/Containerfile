# Sparewall OS image (design: "Platform: a bootc image").
#
# Build from the repository root:
#   podman build -f image/Containerfile -t sparewall:dev .
#
# Fedora base images are used by tag: quay.io prunes a superseded `:45`
# digest within about a day, so a digest pin breaks the build. CI records
# the digests it built from in the run summary.


# ---------------------------------------------------------------------------
# The coordinator and CLI, built against the same Fedora release.
FROM quay.io/fedora/fedora:45 AS build
RUN dnf -y install --setopt=install_weak_deps=False cargo rust gcc \
    && dnf clean all
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates crates
COPY examples examples
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p sparewalld -p sparewall \
    && install -D -m 0755 target/release/sparewalld /out/usr/bin/sparewalld \
    && install -D -m 0755 target/release/sparewall /out/usr/bin/sparewall \
    && /out/usr/bin/sparewall completion bash > /out/sparewall.bash \
    && install -D -m 0644 /out/sparewall.bash /out/usr/share/bash-completion/completions/sparewall \
    && rm /out/sparewall.bash \
    && /out/usr/bin/sparewall schema show > /out/schema.json \
    && install -D -m 0644 /out/schema.json /out/usr/share/sparewall/schema/v1.json \
    && rm /out/schema.json

# ---------------------------------------------------------------------------
# ulogd2 for rule logging; Fedora no longer packages it. ulogd needs
# libnetfilter_log >= 1.0.2 and Fedora 45 has 1.0.1, so that is built too,
# statically, and linked into the NFLOG plugin only.
FROM quay.io/fedora/fedora:45 AS ulogd
ARG NFLOG_VERSION=1.0.2
ARG NFLOG_SHA256=e3f408575614d849e4726b45e90c7ebb0e6744b04859555a9ce6ec40744ffeea
ARG ULOGD_VERSION=2.0.9
ARG ULOGD_SHA256=523a651fe0a9f25b0cd87d5d35fc37d9382e7eecfcf61e48d5505ff3cf80eda5
RUN dnf -y install --setopt=install_weak_deps=False gcc make pkgconf-pkg-config xz bzip2 \
        diffutils file libnfnetlink-devel libmnl-devel libnetfilter_conntrack-devel \
        jansson-devel \
    && dnf clean all
WORKDIR /src
RUN curl -fsSLO https://netfilter.org/pub/libnetfilter_log/libnetfilter_log-${NFLOG_VERSION}.tar.bz2 \
    && echo "${NFLOG_SHA256}  libnetfilter_log-${NFLOG_VERSION}.tar.bz2" | sha256sum -c - \
    && tar -xf libnetfilter_log-${NFLOG_VERSION}.tar.bz2 \
    && cd libnetfilter_log-${NFLOG_VERSION} \
    && ./configure --prefix=/opt/nflog --disable-shared --enable-static --with-pic \
    && make -j"$(nproc)" && make install
RUN curl -fsSLO https://netfilter.org/pub/ulogd/ulogd-${ULOGD_VERSION}.tar.xz \
    && echo "${ULOGD_SHA256}  ulogd-${ULOGD_VERSION}.tar.xz" | sha256sum -c - \
    && tar -xf ulogd-${ULOGD_VERSION}.tar.xz \
    && cd ulogd-${ULOGD_VERSION} \
    && PKG_CONFIG_PATH=/opt/nflog/lib/pkgconfig ./configure --prefix=/usr --libdir=/usr/lib64 \
        --sbindir=/usr/bin --sysconfdir=/etc --disable-static --disable-nfacct --disable-mysql --disable-pgsql \
        --disable-sqlite3 --disable-dbi --disable-pcap \
    && make -j"$(nproc)" \
    && make install DESTDIR=/out \
    && rm -rf /out/usr/share/man /out/usr/lib64/ulogd/*.la \
    && test -f /out/usr/lib64/ulogd/ulogd_inppkt_NFLOG.so \
    && test -f /out/usr/lib64/ulogd/ulogd_output_JSON.so \
    && test ! -e /out/usr/sbin

# ---------------------------------------------------------------------------
# The coordinator's SELinux policy module.
FROM quay.io/fedora/fedora:45 AS selinux
RUN dnf -y install --setopt=install_weak_deps=False selinux-policy-devel make \
    && dnf clean all
COPY image/selinux /src
RUN make -C /src -f /usr/share/selinux/devel/Makefile sparewalld.pp \
    && install -D -m 0644 /src/sparewalld.pp /out/usr/share/selinux/packages/sparewalld.pp

# ---------------------------------------------------------------------------
FROM quay.io/fedora/fedora-bootc:45

# Provider images, pinned by digest in CI so a service and the OS move and
# roll back together (design: "Container conventions").
ARG KEA_IMAGE=ghcr.io/sparewall/kea:testing
ARG UNBOUND_IMAGE=ghcr.io/sparewall/unbound:testing
ARG LEGO_IMAGE=ghcr.io/sparewall/lego:testing

LABEL org.opencontainers.image.title="Sparewall" \
      org.opencontainers.image.description="Image-based Linux firewall: one node or an HA pair, configured from one versioned document" \
      org.opencontainers.image.source="https://github.com/sparewall/sparewall" \
      org.opencontainers.image.url="https://sparewall.org" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.vendor="Sparewall"

# networkd owns every link; NetworkManager and cloud-init go.
RUN for p in NetworkManager NetworkManager-wifi NetworkManager-wwan NetworkManager-team \
             NetworkManager-tui cloud-init firewalld; do \
        if rpm -q "$p" >/dev/null; then dnf -y remove "$p"; fi; \
    done \
    && dnf -y install --setopt=install_weak_deps=False \
        systemd-networkd \
        systemd-resolved \
        nftables \
        keepalived \
        conntrack-tools \
        chrony \
        wireguard-tools \
        restic \
        tcpdump \
        ethtool \
        iproute \
        iputils \
        bind-utils \
        jq \
        node-exporter \
        systemd-journal-remote \
        libnfnetlink \
        libmnl \
        libnetfilter_conntrack \
        jansson \
    && dnf clean all \
    && rm -rf /var/cache/* /var/log/dnf* /var/lib/dnf

# /usr/sbin is a symlink to /usr/bin on Fedora 45: a stage that ships a
# real usr/sbin directory would replace it and hide every tool in it.
COPY --from=build /out/ /
COPY --from=ulogd /out/ /
COPY --from=selinux /out/ /
COPY image/files/ /

RUN test -L /usr/sbin \
    && sed -i -e "s|@KEA_IMAGE@|${KEA_IMAGE}|" /usr/share/containers/systemd/sparewall-kea.container \
    && sed -i -e "s|@UNBOUND_IMAGE@|${UNBOUND_IMAGE}|" /usr/share/containers/systemd/sparewall-unbound.container \
    && sed -i -e "s|@LEGO_IMAGE@|${LEGO_IMAGE}|" /usr/share/containers/systemd/sparewall-lego.image \
    && semodule -i /usr/share/selinux/packages/sparewalld.pp \
    && semodule -l | grep -qx sparewalld \
    && systemctl preset-all \
    && systemctl mask bootc-fetch-apply-updates.timer \
    && chmod 0440 /etc/sudoers.d/sparewall \
    && /usr/bin/sparewall --version \
    && bootc container lint
