[Unit]
Description=Sparewall: keep the credentials host key across a new machine ID
Documentation=https://github.com/sparewall/sparewall
# A node installed from 0.3.2 or 0.3.2-rc1 media had the image's machine
# ID, and gets one of its own on its first boot of a later image. Rewrite
# systemd-creds' host key for it before anything decrypts a secret, or
# systemd-creds deletes the key and every sealed secret is lost (#196).
DefaultDependencies=no
ConditionPathExists=/var/lib/systemd/credential.secret
RequiresMountsFor=/var/lib/systemd
Before=sparewall-early.service sparewalld.service sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/sparewall/rekey-credential-secret
# Stops after sparewalld (the reverse of Before=): puts back the leaked
# header, so a rollback to 0.3.2 finds the key it expects.
ExecStop=/usr/libexec/sparewall/rekey-credential-secret --restore

[Install]
WantedBy=sysinit.target
