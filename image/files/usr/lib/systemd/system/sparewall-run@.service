# Runs one command for sparewalld outside its sandbox: config checks in
# provider images (podman), the keepalived check (unshare), bootc.
# The command is spooled in /run/sparewall/run, which only root can write.
[Unit]
Description=Sparewall helper job %i
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/bin/sparewalld --run %i
# The same binary as the coordinator, but outside its SELinux domain too:
# these commands are the ones the coordinator's confinement forbids.
SELinuxContext=system_u:system_r:unconfined_service_t:s0
TimeoutStartSec=60min
