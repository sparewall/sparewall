[Unit]
Description=Read the seed stick %I
Documentation=https://github.com/sparewall/sparewall
# Every insertion: the script records an identity only while none is
# recorded, and sparewalld applies a configuration only in bootstrap
# mode, so a corrected stick can be put back in.
After=local-fs.target
Before=sparewalld.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/sparewall/seed /dev/%I
PrivateTmp=yes
