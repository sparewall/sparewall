[Unit]
Description=Sparewall rule logging (ulogd2)
Documentation=https://github.com/sparewall/sparewall
After=sparewalld.service
ConditionPathExists=/run/sparewall/logging/ulogd.conf

[Service]
ExecStart=/usr/bin/ulogd -c /run/sparewall/logging/ulogd.conf
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
