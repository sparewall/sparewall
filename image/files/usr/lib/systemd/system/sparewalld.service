[Unit]
Description=Sparewall coordinator
Documentation=https://github.com/sparewall/sparewall
Requires=sparewalld.socket
After=sparewalld.socket sparewall-early.service systemd-networkd.service systemd-udevd.service systemd-tmpfiles-setup.service systemd-sysusers.service
Wants=systemd-networkd.service

[Service]
Type=notify
# The secret store encrypts with the host credential key, which
# systemd-creds creates under /var/lib/systemd on first use: outside the
# sandbox below, so create it first ("+": unsandboxed).
ExecStartPre=+/usr/bin/systemd-creds setup
ExecStart=/usr/bin/sparewalld
ImportCredential=sparewall.*
Restart=on-failure
RestartSec=2s
WatchdogSec=60s
StateDirectory=sparewall
StateDirectoryMode=0711
# The restricted socket (API tokens), which every local user may reach.
RuntimeDirectory=sparewall-api
RuntimeDirectoryMode=0755
Environment=SPAREWALL_LOG=info

# Sandboxing (design: "Host hardening"). The coordinator writes its state,
# runtime networkd files and kernel tunables, and drives nft, networkctl,
# udevadm and ip.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sparewall -/run/systemd/network -/run/sparewall -/etc/sparewall -/var/home/admin/.ssh -/run/chrony -/run/keepalived
# The admin account's authorized_keys live in its home.
ProtectHome=no
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SYS_ADMIN CAP_AUDIT_READ

[Install]
WantedBy=multi-user.target
