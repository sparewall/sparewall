#!/bin/bash
# Keep systemd-creds' host key across a machine ID that changed (#196).
#
# The 0.3.2-rc1 and 0.3.2 images shipped a fixed /etc/machine-id, which a
# systemd scriptlet wrote at build time. A node installed from their media
# has that ID; the next image ships /etc/machine-id empty again, so on its
# first boot the node generates an ID of its own, as it should have from
# the start. systemd-creds binds its host key to the machine ID (the
# file's first 16 bytes are the ID hashed for systemd-creds' application
# ID) and deletes the key once the ID differs, and with it every secret
# the node sealed with --with-key=auto.
#
# Before anything uses systemd-creds, rewrite that header for this boot's
# machine ID: only if it is one of the leaked IDs, so a key copied from a
# genuinely different machine is still refused. The key itself does not
# depend on the machine ID. A no-op once the header is this machine's.
set -euo pipefail
secret=/var/lib/systemd/credential.secret
app=d3acecba0dad4cdfb8c9381528936c58
# The leaked IDs, hashed for $app: 0.3.2-rc1's e54c4926…, 0.3.2's 4c8815c0….
leaked=(1c2d696c62ea45a4a3155e83d3169619 7020f7ab619f40e7b47f508d86f5616f)

[ -s "$secret" ] || exit 0
have=$(head -c 16 "$secret" | od -An -tx1 -v | tr -d ' \n') || { echo "cannot read $secret" >&2; exit 1; }
known=
for l in "${leaked[@]}"; do
    [ "$have" = "$l" ] && known=1
done
# This machine's own, or another machine's: systemd-creds decides.
[ -n "$known" ] || exit 0
# In place, the 16 bytes alone: the same inode keeps what systemd gave it
# (mode, label, and the attributes it sets before writing, such as
# FS_NOCOW), and no second copy of the key is written anywhere.
aside=$secret.unmigrated
fail() {
    # Never leave the key where systemd-creds would delete it: move it
    # aside (a rename, the same inode) and say where. The node runs
    # without its sealed secrets until it is restored.
    echo "cannot rewrite $secret for the new machine ID: $1" >&2
    if mv -f "$secret" "$aside"; then
        echo "kept the old key as $aside: restore it by hand (#196); sealed secrets are unreadable until then" >&2
    fi
    exit 1
}
want=$(systemd-id128 machine-id --app-specific="$app") && [ ${#want} = 32 ] \
    || fail "cannot work out this machine ID's header"
# Still the leaked ID itself (an image that ships it): nothing to do.
[ "$have" != "$want" ] || exit 0
printf '%b' "$(sed 's/../\\x&/g' <<<"$want")" \
    | dd of="$secret" bs=16 count=1 conv=notrunc,fsync status=none \
    || fail "the write failed"
now=$(head -c 16 "$secret" | od -An -tx1 -v | tr -d ' \n') || fail "cannot read it back"
[ "$now" = "$want" ] || fail "it reads back as $now"
echo "kept the credentials host key across the new machine ID (it had the image's leaked one, #196)"
