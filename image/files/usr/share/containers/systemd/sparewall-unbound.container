# Unbound, the recursive resolver. Started, reloaded and stopped by
# sparewalld according to the live generation; not enabled on its own.
[Unit]
Description=Sparewall DNS resolver (Unbound)
Documentation=https://github.com/sparewall/sparewall
After=network-online.target sparewall-early.service
Wants=network-online.target

[Container]
ContainerName=sparewall-unbound
Image=@UNBOUND_IMAGE@
Pull=never
# The image is a logically bound image in bootc's store.
GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
Network=host
DropCapability=all
AddCapability=NET_BIND_SERVICE SETUID SETGID
NoNewPrivileges=true
ReadOnly=true
Volume=/run/sparewall/dns:/etc/unbound:ro,z
Volume=sparewall-unbound-state:/var/lib/unbound:z
Volume=/run/unbound:/run/unbound:z
LogDriver=journald

[Service]
ExecStartPre=/usr/bin/install -d -m 0755 /run/unbound
ExecReload=/usr/bin/podman kill --signal HUP sparewall-unbound
Restart=on-failure
RestartSec=5s
