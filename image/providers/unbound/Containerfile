# Unbound for Sparewall, from Fedora's packages.
FROM quay.io/fedora/fedora-minimal:45@sha256:e6674de05c3eaae918d76d467b15149a3c43a21b0562dad177a86c20e346105e
RUN microdnf -y install --setopt=install_weak_deps=0 unbound \
    && microdnf clean all \
    && install -d -o unbound -g unbound /var/lib/unbound \
    && (unbound-anchor -a /var/lib/unbound/root.key || test -s /var/lib/unbound/root.key) \
    && chown unbound:unbound /var/lib/unbound/root.key \
    && rm -rf /var/cache/* /var/log/*
LABEL org.opencontainers.image.title="Sparewall Unbound" \
      org.opencontainers.image.source="https://github.com/sparewall/sparewall" \
      org.opencontainers.image.licenses="BSD-3-Clause"
ENTRYPOINT []
CMD ["/usr/sbin/unbound", "-d", "-p", "-c", "/etc/unbound/unbound.conf"]
