/usr/bin/sparewalld	--	gen_context(system_u:object_r:sparewalld_exec_t,s0)
/var/lib/sparewall(/.*)?	gen_context(system_u:object_r:sparewalld_var_lib_t,s0)
/run/sparewall(/.*)?	gen_context(system_u:object_r:sparewalld_var_run_t,s0)
/run/sparewall/(dhcp|dns)(/.*)?	gen_context(system_u:object_r:sparewalld_provider_conf_t,s0)
/run/sparewall/ssh(/.*)?	gen_context(system_u:object_r:sparewalld_sshd_conf_t,s0)
/usr/lib/systemd/system/sparewall.*	--	gen_context(system_u:object_r:sparewalld_unit_file_t,s0)
# Units it manages that have no type of their own.
/usr/lib/systemd/system/systemd-journal-upload\.service	--	gen_context(system_u:object_r:sparewalld_unit_file_t,s0)
