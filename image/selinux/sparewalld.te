policy_module(sparewalld, 0.14.0)

########################################
#
# The Sparewall coordinator (design: "Host hardening"), enforcing.
#
# The rules below are what the VM suites showed the coordinator doing,
# with dontaudit rules off so that hidden denials show too. The suites
# fail on any sparewalld_t denial: a change that needs a new access adds
# its rule here. On a node, a one-line module, (typepermissive
# sparewalld_t), makes the domain permissive again while a missing rule
# is found (docs/operations.md).
#
# Grants are to the coordinator's own types wherever it owns the
# objects: its state, runtime and temporary files and its units. Two
# stay with generic types, each explained where it is granted: running
# bin_t commands, and Quadlet's generated units.

type sparewalld_t;
type sparewalld_exec_t;
init_daemon_domain(sparewalld_t, sparewalld_exec_t)
# The units run it with NoNewPrivileges=yes, so systemd's transition into
# the domain is an nnp transition and must be allowed as one.
init_nnp_daemon_domain(sparewalld_t)

# /var/lib/sparewall: identity, keys, generations, secrets, TLS.
type sparewalld_var_lib_t;
files_type(sparewalld_var_lib_t)
# /run/sparewall: rendered configs, sockets, the helper spool.
type sparewalld_var_run_t;
files_pid_file(sparewalld_var_run_t)
# /run/sparewall/dhcp and dns: the providers' rendered configs, which
# their containers read. Mounted without relabelling (no ":z"), so they
# keep this type and the coordinator can still rewrite them.
type sparewalld_provider_conf_t;
files_pid_file(sparewalld_provider_conf_t)
# /run/sparewall/ssh: whether sshd accepts the admin password, which
# sshd reads.
type sparewalld_sshd_conf_t;
files_pid_file(sparewalld_sshd_conf_t)
# Its private /tmp (restic's temporary packs).
type sparewalld_tmp_t;
files_tmp_file(sparewalld_tmp_t)
# Its own units (sparewalld, sparewall-*), and journal-upload's, which
# it starts and has no type of its own.
type sparewalld_unit_file_t;
systemd_unit_file(sparewalld_unit_file_t)

# sparewall-run@ runs the same binary for commands the coordinator's
# confinement forbids, in unconfined_service_t (SELinuxContext=), so that
# domain may be entered through it.
gen_require(`
	type unconfined_service_t;
')
allow unconfined_service_t sparewalld_exec_t:file { entrypoint execute map read open getattr };

gen_require(`
	type unconfined_t, init_t, kernel_t;
	type ifconfig_exec_t, iptables_exec_t, systemd_systemctl_exec_t;
	type udev_exec_t, setfiles_exec_t, conntrackd_exec_t;
	type file_context_t, default_context_t, security_t, selinux_config_t;
	type user_tmp_t;
	type net_conf_t, cert_t, passwd_file_t;
	type user_home_dir_t, ssh_home_t;
	type init_var_lib_t, init_var_run_t, cgroup_t, nsfs_t, sysfs_t;
	type chronyd_var_run_t, keepalived_var_run_t, conntrackd_conf_t;
	type conntrackd_t, conntrackd_var_run_t, ulogd_t, systemd_journal_upload_t;
	type udev_t, udev_var_run_t, tpm_device_t, efivarfs_t;
	type systemd_networkd_t, systemd_networkd_var_run_t;
	type container_t, container_file_t, container_var_lib_t;
	type systemd_generator_unit_file_t;
	type chronyd_unit_file_t, keepalived_unit_file_t, conntrackd_unit_file_t;
	type sshd_t, sshd_unit_file_t;
	type http_port_t, unreserved_port_t, node_t;
	class service { start stop status reload };
')

########################################
#
# Its own sockets and capabilities.
#

# fowner: the admin's authorized_keys is chowned to admin, then its mode
# fixed (the unit grants CAP_FOWNER for this). sys_admin: systemd-creds,
# sealing and unsealing secrets, checks it (the unit grants it); denied,
# it logs and takes another path the suites do not test. net_admin: nft,
# ip and its own netlink requests; the base policy hides its denial, so
# the suites saw it only once dontaudit rules were off (full_audit).
allow sparewalld_t self:capability { chown dac_override fowner net_admin net_bind_service sys_admin };
allow sparewalld_t self:tcp_socket { accept bind connect create getattr getopt listen setopt shutdown read write };
allow sparewalld_t self:unix_dgram_socket { connect create getattr getopt ioctl setattr setopt read write };
allow sparewalld_t self:unix_stream_socket connectto;
allow sparewalld_t self:netlink_route_socket { bind create getattr getopt setopt read write nlmsg_read nlmsg_write };
allow sparewalld_t self:netlink_netfilter_socket { create getopt setopt read write };
# The audit stream's read-only multicast group, for the selinux health
# check: its own denials.
allow sparewalld_t self:capability2 audit_read;
allow sparewalld_t self:netlink_audit_socket { bind create getattr read setopt };
allow sparewalld_t self:netlink_kobject_uevent_socket { bind create getattr getopt setopt read };
# The reach probes: an empty datagram to each address makes the kernel
# resolve it, from the network's own address.
allow sparewalld_t self:udp_socket { bind create getattr setopt write };
allow sparewalld_t node_t:udp_socket node_bind;

# The API and the sync link listen; backups, ACME and the peer are
# reached on whatever port the site configures.
allow sparewalld_t node_t:tcp_socket node_bind;
allow sparewalld_t { http_port_t unreserved_port_t }:tcp_socket name_bind;
corenet_tcp_connect_all_ports(sparewalld_t)
# Names: ACME directories, backup and log destinations, the DNS-01
# server. The suites use addresses, so this is granted by interface.
sysnet_dns_name_resolve(sparewalld_t)

########################################
#
# Its state, runtime and temporary files. What the coordinator creates
# inside its directories inherits their type. tmpfiles relabels
# /var/lib/sparewall at boot, for nodes whose state predates this type.
# sparewall-early runs before tmpfiles and may create /run/sparewall and
# the confined daemons' runtime directories itself, so those are named
# transitions (they need write access to /run itself).
#

manage_dirs_pattern(sparewalld_t, sparewalld_var_lib_t, sparewalld_var_lib_t)
manage_files_pattern(sparewalld_t, sparewalld_var_lib_t, sparewalld_var_lib_t)
files_pid_filetrans(sparewalld_t, sparewalld_var_run_t, dir, "sparewall")
files_pid_filetrans(sparewalld_t, chronyd_var_run_t, dir, "chrony")
files_pid_filetrans(sparewalld_t, keepalived_var_run_t, dir, "keepalived")
allow sparewalld_t { chronyd_var_run_t keepalived_var_run_t }:dir { create setattr };
manage_dirs_pattern(sparewalld_t, sparewalld_var_run_t, sparewalld_var_run_t)
filetrans_pattern(sparewalld_t, sparewalld_var_run_t, sparewalld_provider_conf_t, dir, "dhcp")
filetrans_pattern(sparewalld_t, sparewalld_var_run_t, sparewalld_provider_conf_t, dir, "dns")
filetrans_pattern(sparewalld_t, sparewalld_var_run_t, sparewalld_sshd_conf_t, dir, "ssh")
manage_dirs_pattern(sparewalld_t, sparewalld_sshd_conf_t, sparewalld_sshd_conf_t)
manage_files_pattern(sparewalld_t, sparewalld_sshd_conf_t, sparewalld_sshd_conf_t)
allow sshd_t sparewalld_var_run_t:dir search_dir_perms;
allow sshd_t sparewalld_sshd_conf_t:dir list_dir_perms;
allow sshd_t sparewalld_sshd_conf_t:file read_file_perms;
manage_dirs_pattern(sparewalld_t, sparewalld_provider_conf_t, sparewalld_provider_conf_t)
manage_files_pattern(sparewalld_t, sparewalld_provider_conf_t, sparewalld_provider_conf_t)
manage_files_pattern(sparewalld_t, sparewalld_var_run_t, sparewalld_var_run_t)
manage_sock_files_pattern(sparewalld_t, sparewalld_var_run_t, sparewalld_var_run_t)
manage_fifo_files_pattern(sparewalld_t, sparewalld_var_run_t, sparewalld_var_run_t)
# conntrackd.conf is written here, then given conntrackd's type.
allow sparewalld_t sparewalld_var_run_t:file relabelfrom;
manage_dirs_pattern(sparewalld_t, sparewalld_tmp_t, sparewalld_tmp_t)
manage_files_pattern(sparewalld_t, sparewalld_tmp_t, sparewalld_tmp_t)
files_tmp_filetrans(sparewalld_t, sparewalld_tmp_t, { dir file })

# Confined daemons that read their rendered configs from /run/sparewall
# (ulogd, journal-upload) or reach their own file in it (conntrackd).
# keepalived's scripts run unconfined.
allow { conntrackd_t ulogd_t systemd_journal_upload_t } sparewalld_var_run_t:dir search_dir_perms;
allow { ulogd_t systemd_journal_upload_t } sparewalld_var_run_t:file read_file_perms;
# Kea and Unbound, in containers, read theirs.
allow container_t sparewalld_provider_conf_t:dir list_dir_perms;
allow container_t sparewalld_provider_conf_t:file read_file_perms;
allow systemd_journal_upload_t sparewalld_var_run_t:lnk_file read_lnk_file_perms;

########################################
#
# Host configuration it renders: networkd, the admin's SSH keys, and the
# files confined daemons read, relabelled to the daemon's type.
#

allow sparewalld_t net_conf_t:dir { add_name getattr open read remove_name search write };
allow sparewalld_t net_conf_t:file { create getattr open read rename setattr unlink write };
allow sparewalld_t net_conf_t:lnk_file { create getattr };
allow sparewalld_t user_home_dir_t:dir search;
allow sparewalld_t ssh_home_t:dir { add_name getattr open read remove_name search setattr write };
allow sparewalld_t ssh_home_t:file { create getattr open read rename setattr write };
allow sparewalld_t { chronyd_var_run_t keepalived_var_run_t }:dir { add_name getattr open read relabelto remove_name search write };
allow sparewalld_t { chronyd_var_run_t keepalived_var_run_t }:file { create getattr open relabelto rename setattr unlink write };
allow sparewalld_t chronyd_var_run_t:sock_file getattr;
allow sparewalld_t conntrackd_conf_t:file { getattr ioctl open read relabelto unlink };
allow sparewalld_t cert_t:dir { getattr open read search };
allow sparewalld_t cert_t:file { getattr open read };
allow sparewalld_t passwd_file_t:file { getattr open read };

########################################
#
# Commands it runs in its own domain: ip, nft, systemctl, networkctl,
# udevadm, restorecon, conntrackd, restic and coreutils.
#

allow sparewalld_t { ifconfig_exec_t iptables_exec_t systemd_systemctl_exec_t udev_exec_t setfiles_exec_t conntrackd_exec_t }:file { execute execute_no_trans getattr map open read };
# wg, networkctl, systemd-creds, restic and coreutils are bin_t, like
# most of /usr/bin. Running them adds no privilege: execute_no_trans keeps
# them in sparewalld_t, under these same rules. Labelling each one would
# take the label away from other domains that run it.
corecmd_exec_bin(sparewalld_t)

# restorecon reads the file contexts and walks the mounts.
allow sparewalld_t { file_context_t default_context_t }:dir search;
allow sparewalld_t { file_context_t default_context_t }:file { getattr map open read };
# libselinux, in restorecon and udevadm: the policy type from the
# config, and the kernel's status page; and the selinux health check:
# the mode (/sys/fs/selinux/enforce).
allow sparewalld_t selinux_config_t:file { getattr open read };
allow sparewalld_t security_t:file { getattr map open read };
fs_getattr_all_fs(sparewalld_t)
# Walking the mounts it looks into /run/user; search lists nothing.
allow sparewalld_t user_tmp_t:dir search;

# systemctl, and the units it manages (including Quadlet's). systemctl,
# udevadm and systemd-creds look in /proc/1 (to tell a chroot or
# container: systemd-creds reads its environment).
allow sparewalld_t init_t:dir search;
allow sparewalld_t init_t:file { getattr ioctl open read };
allow sparewalld_t init_t:lnk_file read;
allow sparewalld_t init_var_lib_t:dir { open read search };
allow sparewalld_t init_var_lib_t:file { getattr open read };
allow sparewalld_t init_var_run_t:file { getattr open read };
allow sparewalld_t cgroup_t:dir search;
# Its own cgroup: restic (Go) reads its CPU quota, cpu.max.
allow sparewalld_t cgroup_t:file { open read };
allow sparewalld_t { sparewalld_unit_file_t chronyd_unit_file_t keepalived_unit_file_t conntrackd_unit_file_t }:service { start stop status reload };
# sshd: reloaded when management.ssh.password changes, never stopped.
allow sparewalld_t sshd_unit_file_t:service { start status reload };
# Quadlet generates sparewall-kea and sparewall-unbound at boot, and the
# generator gives every unit it writes this one type, whatever its
# source; file contexts cannot tell them apart.
allow sparewalld_t systemd_generator_unit_file_t:service { start stop status reload };

# udevadm settle, and udevadm info, which reads a device's properties
# from /run/udev/data to match a .link file's Path= to an interface.
allow sparewalld_t udev_var_run_t:dir { getattr search };
allow sparewalld_t udev_var_run_t:file { getattr open read };
allow sparewalld_t udev_var_run_t:lnk_file read;
allow sparewalld_t udev_var_run_t:sock_file write;
allow sparewalld_t udev_t:unix_stream_socket connectto;

# systemd-creds seals secrets to the TPM through the resource manager,
# /dev/tpmrm0, where a node has one (--with-key=auto). Found with the
# domain permissive on a node with a TPM: it also reads the PCR banks
# the boot loader activated from an EFI variable, credits the kernel's
# entropy pool from the TPM's generator, and marks that done in
# /run/systemd/tpm-rng-credited (best effort: without the marker it only
# mixes TPM entropy in again next time). The marker is created with the
# coordinator's own run type, so that it adds a name to /run/systemd but
# writes, renames and removes nothing of init's there.
dev_list_all_dev_nodes(sparewalld_t)
allow sparewalld_t tpm_device_t:chr_file { getattr ioctl open read write };
allow sparewalld_t efivarfs_t:dir { getattr search open read };
allow sparewalld_t efivarfs_t:file { getattr open read };
dev_write_urand(sparewalld_t)
type_transition sparewalld_t init_var_run_t:file sparewalld_var_run_t "tpm-rng-credited";
allow sparewalld_t init_var_run_t:dir { add_name write };
allow sparewalld_t sparewalld_var_run_t:file { create getattr open write };

# The login banner, /run/motd.d/50-sparewall (#83), written in place.
gen_require(`
	type motd_var_run_t;
')
allow sparewalld_t motd_var_run_t:dir { getattr search open read write add_name remove_name };
allow sparewalld_t motd_var_run_t:file { create getattr open write setattr unlink };

# Kernel state: net sysctls, sysfs, network namespaces.
kernel_rw_net_sysctls(sparewalld_t)
allow sparewalld_t sysfs_t:file { open write };
allow sparewalld_t nsfs_t:file getattr;
# The loginuid of an admin's CLI process, to record who made a change.
allow sparewalld_t unconfined_t:dir search;
allow sparewalld_t unconfined_t:file { getattr open read };

########################################
#
# Daemons it talks to: the journal, networkd, conntrackd and the
# provider containers (Kea's control socket).
#

logging_send_syslog_msg(sparewalld_t)
# systemd's journal and notify sockets.
allow sparewalld_t kernel_t:unix_dgram_socket sendto;
allow sparewalld_t systemd_networkd_var_run_t:dir search;
allow sparewalld_t systemd_networkd_var_run_t:sock_file write;
allow sparewalld_t systemd_networkd_t:unix_stream_socket connectto;
allow sparewalld_t conntrackd_var_run_t:sock_file write;
allow sparewalld_t conntrackd_t:unix_stream_socket connectto;
allow sparewalld_t container_var_lib_t:dir search;
allow sparewalld_t container_file_t:dir search;
allow sparewalld_t container_file_t:file { open read };
allow sparewalld_t container_file_t:sock_file write;
allow sparewalld_t container_t:unix_stream_socket connectto;

########################################
#
# keepalived, which the coordinator configures and reloads.
#

gen_require(`
	type keepalived_t, keepalived_unconfined_script_t;
')
# On a reload keepalived signals each running script's process group,
# -getpgid(pid). Fedora's policy lets it getpgid only itself, so for a
# running track script it got -1 and signalled init instead: systemd
# re-executed, failing the apply's "systemctl reload" (#66; upstream
# acassen/keepalived#2743).
allow keepalived_t keepalived_unconfined_script_t:process getpgid;

########################################
#
# bootc, which sparewall-run@ (unconfined_service_t) runs for upgrades.
#

gen_require(`
	type unconfined_service_t, install_t, install_exec_t;
')
# Into install_t, as from an admin's shell (unconfined_t). Left in
# unconfined_service_t, bootc lacks mac_admin, and its probe for it (a
# chcon to an undefined label) is denied and logged on every run (#110).
# install_exec_t is bootc, ostree and rpm-ostree; the only other
# unconfined service on a node, node_exporter, runs none of them.
domtrans_pattern(unconfined_service_t, install_exec_t, install_t)

########################################
#
# bootupd, which updates the bootloader at boot (bootloader-update.service).
#

gen_require(`
	type bootupd_t, default_t;
')
# bootupctl reads /sysroot/.bootc-aleph.json, which bootc's installer
# writes and Fedora's policy labels default_t (#111).
allow bootupd_t default_t:file { getattr open read };
